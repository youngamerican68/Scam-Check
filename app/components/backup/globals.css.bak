/* app/globals.css */
@tailwind base;
@tailwind components;
@tailwind utilities;

/* Custom Scrollbar Styles */
.custom-scrollbar::-webkit-scrollbar {
  width: 8px;
}

.custom-scrollbar::-webkit-scrollbar-track {
  background: #f5f5f4;
  border-radius: 4px;
}

.custom-scrollbar::-webkit-scrollbar-thumb {
  background: #a8a29e;
  border-radius: 4px;
}

.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: #78716c;
}

/* Font Family CSS Variables */
@layer base {
  :root {
    --font-inter: 'Inter', sans-serif;
    --font-playfair: 'Playfair Display', serif;
  }

  .font-sans {
    font-family: var(--font-inter);
  }

  .font-serif {
    font-family: var(--font-playfair);
  }
}

/* Custom animations */
@keyframes fadeIn {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.animate-fadeIn {
  animation: fadeIn 0.4s ease-out;
}

/* Base styles for better readability */
@layer base {
  body {
    @apply text-neutral-900;
  }

  /* Ensure good contrast for accessibility */
  strong,
  b {
    @apply font-semibold;
  }

  /* Smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Focus styles for accessibility */
  *:focus-visible {
    @apply outline-2 outline-offset-2 outline-blue-600;
  }
}

/* Component utilities */
@layer components {
  /* Card-like containers */
  .card {
    @apply bg-white rounded-lg shadow-md p-6;
  }

  /* Button variants */
  .btn-primary {
    @apply bg-blue-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-blue-700 focus:ring-4 focus:ring-blue-300 transition-colors;
  }

  .btn-secondary {
    @apply bg-neutral-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-neutral-700 focus:ring-4 focus:ring-neutral-300 transition-colors;
  }

  .btn-danger {
    @apply bg-danger-600 text-white font-semibold py-2 px-4 rounded-lg hover:bg-danger-700 focus:ring-4 focus:ring-danger-300 transition-colors;
  }
}

/* Utility classes */
@layer utilities {
  /* Text selection */
  ::selection {
    @apply bg-blue-200 text-blue-900;
  }

  /* Print styles */
  @media print {
    .no-print {
      display: none !important;
    }
  }
}

/* Accessibility improvements */
@media (prefers-reduced-motion: reduce) {
  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}

/* High contrast mode support */
@media (prefers-contrast: high) {
  .border {
    @apply border-2;
  }
}

/* Dark mode support (future enhancement) */
@media (prefers-color-scheme: dark) {
  /* Currently using light mode only for accessibility to elderly users */
  /* Can be implemented later if needed */
}
