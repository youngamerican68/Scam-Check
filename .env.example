# AI Provider Configuration
# Choose your provider: openai, mistral, openrouter, nemotron, or mock
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Mistral Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# OpenRouter Configuration (Recommended - Access to 100+ models)
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Recommended models:
# - anthropic/claude-3.5-sonnet (best reasoning, $3/$15 per 1M tokens)
# - meta-llama/llama-3.1-70b-instruct (cost-effective, $0.35/$0.40 per 1M tokens)
# - google/gemini-flash-1.5 (fastest, $0.075/$0.30 per 1M tokens)
# - openai/gpt-4o (versatile, $2.50/$10 per 1M tokens)
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# Nemotron / Custom vLLM Configuration
CUSTOM_AI_ENDPOINT=https://your-vllm-endpoint.com/v1
CUSTOM_AI_API_KEY=your_custom_api_key_here
CUSTOM_AI_MODEL=nvidia/nemotron-70b

# App Configuration
MAX_TEXT_LENGTH=8000
MAX_IMAGE_SIZE_MB=5

# Optional: Site info for OpenRouter ranking/credits
SITE_URL=https://scamshield.app
SITE_NAME=Scam Shield

# ============================================================================
# Authentication & Payments (Required for production)
# ============================================================================

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32

# Google OAuth (get from console.cloud.google.com)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Email Provider (optional - for magic link login)
EMAIL_SERVER_HOST=smtp.gmail.com
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=your-email@gmail.com
EMAIL_SERVER_PASSWORD=your-app-password
EMAIL_FROM=noreply@scamshield.app

# Stripe Payment Processing (get from stripe.com/dashboard)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Vercel KV (Redis) - Auto-configured when you enable KV in Vercel
# For local dev: run `vercel env pull .env.local`
KV_URL=redis://your-kv-url
KV_REST_API_URL=https://your-kv-rest-api-url
KV_REST_API_TOKEN=your-kv-token
KV_REST_API_READ_ONLY_TOKEN=your-kv-read-only-token
