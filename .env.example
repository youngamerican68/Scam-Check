# AI Provider Configuration
# Choose your provider: openai, mistral, nemotron, or mock
AI_PROVIDER=mock

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4-turbo-preview

# Mistral Configuration
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_MODEL=mistral-large-latest

# Nemotron / Custom vLLM Configuration
CUSTOM_AI_ENDPOINT=https://your-vllm-endpoint.com/v1
CUSTOM_AI_API_KEY=your_custom_api_key_here
CUSTOM_AI_MODEL=nvidia/nemotron-70b

# App Configuration
MAX_TEXT_LENGTH=8000
MAX_IMAGE_SIZE_MB=5
